{
  "manifest_version": 3,
  "name": "Sari - VA Assistant",
  "version": "1.2.3",
  "description": "Your all-in-one freelancing companion for VAs: job scanning, AI pitches, vault autofill, scam checks and time tracking.",
  "author": "Sari (Vascora OÜ)",
  "homepage_url": "https://getsari.com",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://getsari.com/*",
    "http://localhost:3000/*",
    "https://www.upwork.com/*",
    "https://www.onlinejobs.ph/*",
    "https://www.facebook.com/*",
    "https://www.linkedin.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/*",
        "https://www.onlinejobs.ph/*",
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://getsari.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "webapp-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

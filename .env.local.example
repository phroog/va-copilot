NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── Global Live Job Feed ──────────────────────────────────────────
# Random string protecting the web upload / pending-sources endpoints.
# Used by the admin collector (collector/collector.mjs) via the
# x-admin-secret header. End users never scrape — only the admin runs
# the collector, on the laptop now and on a server later.
ADMIN_SECRET=generate-a-long-random-string

# ── Private Admin Dashboard (operator only) ────────────────────────
# Separate password login at /admin (independent of the user auth system).
# Login is at https://your-domain.com/admin/login. Session is a signed
# HttpOnly cookie lasting 12 hours, signed with ADMIN_SECRET.
ADMIN_DASHBOARD_USERNAME=your-admin-username
ADMIN_DASHBOARD_PASSWORD=generate-a-long-random-password

# Optional — Google Calendar Sync — create a Google Cloud project, enable Calendar API,
# and create OAuth 2.0 credentials (Web application type). Add
# http://localhost:3000/auth/callback and https://your-domain.com/auth/callback
# to Authorized redirect URIs.
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID is the public client ID used by the browser.
# GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are used server-side.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

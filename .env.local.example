NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── Global Live Job Feed ──────────────────────────────────────────
# Random string protecting the Vercel Cron collector endpoint.
# Used in vercel.json as the cron "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=generate-a-long-random-string

# Random string protecting the extension "Admin Mode" web upload endpoint.
# Paste this same value into the extension's Admin Mode settings.
ADMIN_SECRET=generate-another-long-random-string

# Optional — Jooble jobs API key (only if you add a Jooble API source).
# JOOBLE_API_KEY=your-jooble-key

# Optional — Google Custom Search JSON API (only if you use Google CSE).
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CSE_ID=your-cse-id

# Google Calendar Sync — create a Google Cloud project, enable Calendar API,
# and create OAuth 2.0 credentials (Web application type). Add
# http://localhost:3000/auth/callback and https://your-domain.com/auth/callback
# to Authorized redirect URIs.
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID is the public client ID used by the browser.
# GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are used server-side.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

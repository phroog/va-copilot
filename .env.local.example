NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── Global Live Job Feed ──────────────────────────────────────────
# Random string protecting the web upload / pending-sources endpoints.
# Used by the admin collector (collector/collector.mjs) via the
# x-admin-secret header. End users never scrape — only the admin runs
# the collector, on the laptop now and on a server later.
ADMIN_SECRET=generate-a-long-random-string

# ── Private Admin Dashboard (operator only) ────────────────────────
# Separate password login at /admin (independent of the user auth system).
# Login is at https://your-domain.com/admin/login. Session is a signed
# HttpOnly cookie lasting 12 hours, signed with ADMIN_SECRET.
ADMIN_DASHBOARD_USERNAME=your-admin-username
ADMIN_DASHBOARD_PASSWORD=generate-a-long-random-password

# Optional — Google Calendar Sync — create a Google Cloud project, enable Calendar API,
# and create OAuth 2.0 credentials (Web application type). Add
# http://localhost:3000/auth/callback and https://your-domain.com/auth/callback
# to Authorized redirect URIs.
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID is the public client ID used by the browser.
# GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are used server-side.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Subscription / Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_PRICE_BASIC=price_basic_xxx
STRIPE_PRICE_PRO=price_pro_xxx


# Telegram Bot (push + commands)
# 1) Create a bot via @BotFather in Telegram, copy the token.
# 2) Set the webhook (after deploy):
#    https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://your-domain.com/api/telegram/webhook
# 3) (Optional but recommended) set a secret for webhook verification.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
# TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Realtime push (Supabase Edge Function `telegram-push`)
# The SQL trigger (032_telegram_realtime.sql) posts to the Edge Function. Set:
#   app.telegram_push_url    -> https://<project-ref>.supabase.co/functions/v1/telegram-push
#   app.telegram_push_secret -> a shared secret (also set in the Edge Function env)
# plus in the Edge Function env (dashboard): SUPABASE_SERVICE_ROLE_KEY + TELEGRAM_BOT_TOKEN


# Outbound email (Resend) � transactional + marketing.
# Create a Resend account, add an API key, verify a sending domain (or use
# onboarding@resend.dev for testing only). Supabase Auth emails (verify/reset)
# are configured separately in the Supabase dashboard (Auth ? SMTP settings).
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Sari <hello@vascora.com>
